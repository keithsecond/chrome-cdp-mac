#!/bin/zsh

# Ensure seccomp profile is staged
if [ ! -f "$HOME/chrome.json" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$SCRIPT_DIR/seccomp/chrome.json" ]; then
        echo "Staging seccomp profile to ~/chrome.json"
        cp "$SCRIPT_DIR/seccomp/chrome.json" "$HOME/chrome.json"
    else
        echo "Error: seccomp/chrome.json not found" >&2
        exit 1
    fi
fi

# XQuartz check
XQUARTZ_LINE=$(netstat -an -p tcp | awk '$4 ~ /.600[0-3]$/ && $6 == "LISTEN" {print; exit}')
if [[ -z "$XQUARTZ_LINE" ]]; then
    echo 'XQuartz not running. run "open -a XQuartz", allow your IP with "xhost +$IP" and try again'
    exit 1
fi
DP=$(echo "$XQUARTZ_LINE" | awk '{sub(/.*\.600/, "", $4); print $4}')

# Wifi and ethernet bouncing. This may be wildly different for your network.
INT=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')
IP=$(ifconfig $INT 2>/dev/null | grep inet | awk '$1=="inet" {print $2}')

if [ -z "$IP" ]; then
  echo "Could not determine host IP" >&2
  exit 1
fi

#xhost assignment
xhost +127.0.0.1 $IP

echo "Using $INT -> $IP"
echo "Using display :$DP"

docker run -d \
  --name chrome-cdp \
  -p 127.0.0.1:9222:9222 \
  -e DISPLAY=$IP:$DP \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  -v "$HOME/chrome-cdp-profile:/data" \
  --security-opt seccomp=$HOME/chrome.json \
  --shm-size=2g \
  chrome-cdp:local
